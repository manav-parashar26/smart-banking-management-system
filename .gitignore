# =============================================================================
# Smart Banking Management System — .gitignore
# =============================================================================

# Compiled Executables & Binaries
*.exe
*.obj
*.o
*.a
*.lib
*.dll
*.so
*.dylib
*.pdb
*.ilk
*.exp

# Build Artifacts & CMake Directories
build/
bin/
out/
target/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake

# Temporary Staging Files & Test Sandbox Artifacts
*.tmp
*.temp
data/*.tmp
data/corrupt_sample.txt

# Application Logs & Crash Dumps
*.log
*.dump
*.dmp

# Environment Configuration & Local Secrets
.env
.env.*
!.env.example
secrets.json
*.local

# IDE & Editor Metadata
.vscode/
.idea/
*.suo
*.user
*.userosv
*.sln
*.vcxproj
*.vcxproj.*
.vs/
*.swp
*~
.DS_Store
Thumbs.db
